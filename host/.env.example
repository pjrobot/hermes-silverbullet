# Pin real releases. SilverBullet release tags are bare (2.10.0), not v-prefixed.
SILVERBULLET_VERSION=2.10.0
HERMES_VERSION=v2026.9.24

SPACE_DIR=/srv/silverbullet/space
# The space's owner. SilverBullet, the Hermes agent and the snapshot watcher
# must all write as this uid, or each leaves files the others cannot edit.
SPACE_UID=1000
SPACE_GID=1000

HERMES_DATA_DIR=/srv/hermes/data
# Seed with: mkdir -p "$QMD_CONFIG_DIR" && cp qmd/index.yml "$QMD_CONFIG_DIR"/
QMD_CONFIG_DIR=/srv/qmd/config

# username:password for SilverBullet's single-user login. Required.
SB_USER=
