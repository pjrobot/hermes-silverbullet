# Copy to /etc/systemd/system/, adjust the paths and user, then:
#   systemctl daemon-reload && systemctl enable --now silverbullet-snapshot-watch
[Unit]
Description=Commit the SilverBullet space to git when it changes
After=local-fs.target

[Service]
Type=simple
# The space owner (SPACE_UID), so commits never leave objects in .git that
# another writer cannot write past.
User=1000
Group=1000
ExecStart=/opt/hermes-silverbullet/host/scripts/snapshot-watch.sh /srv/silverbullet/space
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
